        {
            "id": "github-git-clone",
            "label": "Plugin · installed via git clone",
            "when": "The package is not an executable but a plugin / extension for a host application, and has to be git cloned into the host directory. depends is mandatory.",
            "builder": "github_git_clone",
            "defaults": {},
            "required": [
                "version",
                "desc",
                "homepage",
                "license",
                "url",
                "depends",
                "installer_script",
                "checkver_url",
                "checkver_jsonpath",
                "checkver_regex"
