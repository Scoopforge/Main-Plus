{
    "schema": 1,
    "default_recipe": "github-cli-archive",
    "summary_sections": [
        "⭐️ Summary"
    ],
    "readme": {
        "default_section": "⭐️ Summary",
        "auto_mark": "✓"
    },
    "param_docs": {
        "version": "Upstream version string, without the leading v (e.g. 2.1.46)",
        "desc": "One-line English description. Capitalized, no trailing period, <=120 chars",
        "homepage": "Upstream homepage or repository URL",
        "license": "SPDX identifier (MIT / Apache-2.0 / GPL-3.0-or-later); use Proprietary for closed-source, or {\"identifier\":..., \"url\":...}",
        "comment": "Free text for the `##` key, the documented Scoop convention for a comment inside a manifest",
        "arch": "Architecture set: 64bit, arm64, or the + joined pair 64bit+arm64; defaults to 64bit. 32bit is rejected",
        "arch_block": "Keep the architecture block even when only one architecture is listed. Default true for the recipes that model this bucket's mainstream shapes (it writes a one-key 64bit block for 19 of its 39 manifests against 6 flat pairs); --flat-url forces the collapsed top-level url/hash form",
        "url64": "64bit direct download URL. Hard-code the current version in it",
        "url_arm64": "arm64 direct download URL (required when arch includes arm64)",
        "url": "Single-architecture direct download URL (non-GitHub cases)",
        "hash64": "sha256 for url64. A sha1: / sha512: / md5: prefixed digest is accepted only when autoupdate.hash says where Excavator refetches it",
        "hash_arm64": "sha256 for url_arm64, same prefix rule as hash64",
        "repo_url": "GitHub repository URL, for the checkver github form (e.g. https://github.com/o/r)",
        "extract_dir": "Directory name inside the archive. Always $PLUGINSDIR for electron-builder output. When it embeds the version, autoupdate.extract_dir is templated automatically",
        "extract_to": "Target subdirectory to extract into. Use the same value as extract_dir when paired",
        "nsis_payload": "Name of the inner 7z inside an electron-builder NSIS installer; defaults to app-64.7z (app-arm64.7z on arm64)",
        "msi_mode": "How to handle an .msi download: extract (unpack into $dir with Expand-MsiArchive, portable) or install (run msiexec, needs admin). Defaults to extract",
        "msi_args": "Extra msiexec flags used by msi_mode=install; defaults to /qn and /norestart",
        "shortcut_exe": "Executable the shortcut points to, relative to $dir, using backslashes (e.g. bin\\App.exe)",
        "shortcut_name": "Display name in the Start menu",
        "shortcut_entries": "Verbatim shortcuts array, for several entries or a submenu path. Overrides shortcut_exe",
        "bin_exe": "Executable to put on PATH, relative to $dir",
        "bin_alias": "Command-line alias (shim name)",
        "bin_entries": "Verbatim bin array, for several executables or a mix of plain and aliased entries. Overrides bin_exe",
        "persist": "Directory or file to keep across versions (relative to $dir); an array is allowed",
        "psmodule_name": "PowerShell module name, for the psmodule block (e.g. CompletionPredictor)",
        "psmodule_path": "Optional subdirectory holding the module inside the package",
        "extra_urls": "Sidecar files downloaded alongside the main package, as an array of URLs",
        "extra_hashes": "sha256 digests matching extra_urls one for one",
        "env_add_path": "Directory appended to PATH on install, relative to $dir",
        "env_set": "Object of environment variables written on install",
        "installer_script": "Custom install script (PowerShell snippet array or single string), runs inside $dir",
        "installer_file": "Run a file that came with the package instead of a script (e.g. a bundled setup exe)",
        "installer_args": "Argument array handed to installer_file",
        "uninstaller_script": "Custom uninstall script",
        "post_install": "Post-install cleanup script",
        "pre_install": "Pre-install preparation script",
        "pre_uninstall": "Script run before uninstall (e.g. msiexec /x for msi_mode=install)",
        "post_uninstall": "Script run after uninstall (e.g. removing a leftover %APPDATA% directory)",
        "checkver_github": "GitHub repository URL for the checkver github key. Never an api.github.com URL: Scoop appends /releases/latest itself",
        "checkver_url": "Web page / API endpoint used to detect the version. Optional: without it Scoop scrapes the homepage, and a regex on its own collapses to the bare-string checkver shorthand",
        "checkver_regex": "Regex extracting the version from the checkver_url response; prefer a (?<version>...) named group",
        "checkver_jsonpath": "jsonpath picking a value out of a JSON response (e.g. $.assets[*].browser_download_url)",
        "checkver_xpath": "xpath picking a value out of an XML response",
        "checkver_replace": "Template rearranging regex named groups into a version (e.g. ${year}.${month}.${day})",
        "checkver_reverse": "Set true to take the last regex match instead of the first; for pages that list newest first",
        "checkver_script": "PowerShell snippet returning the text checkver_regex runs against; needs a Scoop environment, so update --checkver cannot probe it offline",
        "checkver_sourceforge": "SourceForge project path for the checkver sourceforge key (e.g. beebeep/Windows)",
        "checkver_useragent": "Custom User-Agent for the checkver request, when the site blocks the default",
        "url_au": "URL template for autoupdate, containing $version. Use $matchName / $matchBuild to carry extra named groups from checkver_regex",
        "au_hash_url": "URL autoupdate fetches the hash from (a checksum file, or a release asset such as latest.yml)",
        "au_hash_regex": "Regex pulling sha256 out of the checksum file; may use $sha256 / $sha1 / $sha512 / $basename / $base64",
        "notes": "Install notes, shown in scoop output",
        "suggest": "Packages suggested alongside (scoop form, e.g. extras/7zip)",
        "depends": "Hard dependency (scoop form)",
        "language": "Implementation language shown in the README summary table (Rust / Go / Python / C++ / …). Optional: omitting it leaves the existing cell alone",
        "section": "README summary table section, see summary_sections"
    },
    "recipes": [
        {
            "id": "github-portable-zip",
            "label": "GitHub Release · portable archive",
            "when": "The release ships a plain .zip / .7z / .tar.gz portable archive that works once extracted, with no installer.",
            "builder": "github_portable_zip",
            "defaults": {
                "arch": "64bit"
            },
            "required": [
                "version",
                "desc",
                "homepage",
                "license",
                "url64"
            ],
            "optional": [
                "comment",
                "repo_url",
                "arch",
                "url_arm64",
                "hash64",
                "hash_arm64",
                "extract_dir",
                "shortcut_exe",
                "shortcut_name",
                "shortcut_entries",
                "bin_exe",
                "bin_alias",
                "bin_entries",
                "env_set",
                "env_add_path",
                "persist",
                "suggest",
                "notes"
            ],
            "refs": [
                "cargo-update",
                "cryptomator-cli",
                "feynman",
                "ltex-ls-plus",
                "commix",
                "micromamba",
                "nebula",
                "typst-ts"
            ]
        },
        {
            "id": "github-nsis-7z",
            "label": "GitHub Release · NSIS shell (7z extraction)",
            "when": "The release is an NSIS .exe whose real payload is a 7z under $PLUGINSDIR. Skip the installer and treat the shell as a 7z. Reach for it when the payload is not an Electron app too: any NSIS container with a $PLUGINSDIR payload fits.",
            "builder": "github_nsis_7z",
            "defaults": {
                "arch": "64bit",
                "nsis_payload": "app-64.7z"
            },
            "required": [
                "version",
                "desc",
                "homepage",
                "license",
                "url64"
            ],
            "optional": [
                "comment",
                "repo_url",
                "arch",
                "url_arm64",
                "hash64",
                "hash_arm64",
                "nsis_payload",
                "shortcut_exe",
                "shortcut_name",
                "shortcut_entries",
                "bin_exe",
                "bin_alias",
                "bin_entries",
                "env_set",
                "env_add_path",
                "persist",
                "notes"
            ],
            "refs": [
                "azure-functions-core-tools",
                "exercism",
                "ghostscript",
                "git-annex",
                "gpac",
                "graphviz",
                "iverilog",
