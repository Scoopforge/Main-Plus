        {
            "id": "github-single-exe",
            "label": "GitHub Release · single portable exe",
            "when": "The release is a bare .exe, usable as-is with no extraction. Usually exposed through bin; in this repo the same release ships one exe per architecture, so set arch to 64bit+arm64 and give url_arm64 as well.",
            "builder": "github_single_exe",
            "defaults": {
                "arch": "64bit",
                "arch_block": true
            },
            "required": [
                "version",
                "desc",
                "homepage",
                "license",
                "url64"
