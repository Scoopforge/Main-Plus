        {
            "id": "github-asset-jsonpath",
            "label": "GitHub Release · version read from the asset list",
            "when": "The release filename carries more than the version (a build number, a codename), so the download URL cannot be rebuilt by swapping $version alone. Read the asset list from the GitHub API and carry the extra fields through $match* placeholders.",
            "builder": "github_asset_jsonpath",
            "defaults": {
                "arch": "64bit"
            },
            "required": [
                "version",
                "desc",
                "homepage",
                "license",
