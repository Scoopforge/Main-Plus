        {
            "id": "github-cli-archive",
            "label": "GitHub Release · CLI tool exposed through bin",
            "when": "The release is a command-line tool: an archive or a bare exe holding one or more executables, and the manifest's entire job is putting them on PATH. This is the default shape of this bucket (38 of its 39 manifests) and of the upstream main bucket (1469 of 1653 declare a bin and no shortcuts). Prefer it over github-portable-zip whenever nothing is installed outside PATH; .tar.gz / .tar.xz / .tar.zst / .tar.lzma payloads are fine, only the URL changes.",
            "builder": "github_cli_archive",
            "defaults": {
                "arch": "64bit",
                "arch_block": true
            },
            "required": [
                "version",
                "desc",
                "homepage",
                "license",
                "url64",
                "bin_exe"
            ],
            "optional": [
                "comment",
                "repo_url",
                "arch",
                "url_arm64",
                "hash64",
                "hash_arm64",
                "extract_dir",
                "bin_alias",
                "bin_entries",
                "env_set",
                "env_add_path",
                "persist",
                "suggest",
                "notes"
            ],
            "refs": [
                "cargo-dist",
                "calepin",
                "sttr",
                "tex-fmt",
                "typdiff",
                "sendme",
                "act",
                "air"
            ]
        },
        {
            "id": "toolchain-env",
            "label": "Vendor toolchain · installed through the environment",
            "when": "A compiler / SDK / runtime that you never shim: the archive is unpacked, one of its subdirectories goes on PATH with env_add_path, and one or more *_HOME variables point at $dir with env_set. Upstream, 123 manifests install nothing through bin, shortcuts or psmodule, and 88 of them reach for env_add_path; autoupdate usually has to re-template extract_dir as well, because the vendor archive is named after the version.",
            "builder": "toolchain_env",
            "defaults": {
                "arch": "64bit",
                "arch_block": true
            },
            "required": [
                "version",
                "desc",
                "homepage",
                "license",
                "url64"
            ],
            "optional": [
                "comment",
                "repo_url",
                "arch",
                "url_arm64",
                "hash64",
                "hash_arm64",
                "extract_dir",
                "env_add_path",
                "env_set",
                "bin_exe",
                "bin_alias",
                "bin_entries",
                "pre_install",
                "uninstaller_script",
                "persist",
                "suggest",
                "notes"
            ],
            "refs": [
                "ant",
                "glfw",
                "gnutls",
                "ldc",
                "libvips",
                "llvm",
                "maven",
                "mingw"
            ]
        }
    ]
